{
  "version": 2,
  "buildCommand": "npx expo export",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/",
      "dest": "/landing.html",
      "has": [{ "type": "host", "value": "viscare.app.br" }]
    },
    {
      "src": "/",
      "dest": "/landing.html",
      "has": [{ "type": "host", "value": "www.viscare.app.br" }]
    },
    {
      "src": "/terms",
      "dest": "/terms.html",
      "has": [{ "type": "host", "value": "viscare.app.br" }]
    },
    {
      "src": "/terms",
      "dest": "/terms.html",
      "has": [{ "type": "host", "value": "www.viscare.app.br" }]
    },
    {
      "src": "/privacy",
      "dest": "/privacy.html",
      "has": [{ "type": "host", "value": "viscare.app.br" }]
    },
    {
      "src": "/privacy",
      "dest": "/privacy.html",
      "has": [{ "type": "host", "value": "www.viscare.app.br" }]
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
